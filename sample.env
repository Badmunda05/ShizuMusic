# Copy to .env (VPS) or paste the whole thing into Voroa → Environment → "paste .env"
# ── Required ──
API_ID=
API_HASH=
BOT_TOKEN=
STRING_SESSION=
MONGO_DB_URL=
OWNER_ID=

# ── Download: cookies first, API fallback ──
USE_COOKIES=True        # True: cookies first, API fallback | False: API first
COOKIES_URL=            # batbin.me links, space separated
API_URL=                # optional, your download API
API_KEY=                # optional

# ── Optional ──
LOGGER_ID=
BOT_NAME=
BOT_LINK=
SUPPORT_GROUP=
UPDATES_CHANNEL=
PING_IMG_URL=
SESSION_NAME=ShizuMusic
# PORT is set automatically by Voroa / Render / Koyeb (default 10000)
